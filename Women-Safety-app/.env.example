# SHEILD App Environment Configuration
# Copy this file to .env and fill in your values
# All services below have FREE tiers — no payment needed

# ===== BLOCKCHAIN (Polygon Amoy Testnet - FREE) =====
# Public RPC (no account needed):
BLOCKCHAIN_RPC_URL=https://rpc-amoy.polygon.technology/

# Deploy IncidentRegistry.sol to Polygon Amoy (free) using Remix IDE:
# 1. Open https://remix.ethereum.org
# 2. Paste contracts/IncidentRegistry.sol
# 3. Compile with Solidity 0.8.x
# 4. Deploy to "Injected Provider" with MetaMask on Amoy network
# 5. Copy deployed contract address here
BLOCKCHAIN_CONTRACT_ADDRESS=

# MetaMask wallet private key (TESTNET ONLY — never use mainnet keys)
# 1. Get free testnet MATIC from https://faucet.polygon.technology/
# 2. Export private key from MetaMask (Account Details → Export)
BLOCKCHAIN_PRIVATE_KEY=d14e5a832c9fec2e3aea35e02cdcb04e0af1aa17aca5936b0e9be7807b24f3ee

# ===== IPFS STORAGE (Pinata - FREE: 1GB) =====
# 1. Create free account at https://app.pinata.cloud/
# 2. Go to API Keys → New Key → copy JWT
PINATA_JWT=

# ===== ENCRYPTION =====
# App-level secret for AES-256 key derivation (set any random string)
APP_SECRET=change_me_to_a_random_string

# ===== TWILIO SMS (Optional) =====
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
