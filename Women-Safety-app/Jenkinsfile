// SHEILD CI/CD Pipeline - Jenkins Declarative Pipeline
// Automates: Build → Test → Security Scan → Deploy
// Reference: Research Paper Section IV-D

pipeline {
    agent any
shr
    environment {
        DOCKER_IMAGE    = 'sheild-backend'
        DOCKER_TAG      = "${BUILD_NUMBER}"
        CONTAINER_NAME  = 'sheild-api'
        APP_PORT        = '5000'
    }

    options {
        timeout(time: 15, unit: 'MINUTES')
        timestamps()
        buildDiscarder(logRotator(numToKeepStr: '5'))
    }

    stages {

        stage('Checkout') {
            steps {
                echo '📥 Pulling latest code...'
                checkout scm
            }
        }

        stage('Build Docker Image') {
            steps {
                echo '🔨 Building Docker image for SHEILD backend...'
                dir('assets') {
                    script {
                        docker.build("${DOCKER_IMAGE}:${DOCKER_TAG}")
                    }
                }
            }
        }

        stage('Unit Tests') {
            steps {
                echo '🧪 Running backend API tests...'
                dir('assets') {
                    script {
                        docker.image("${DOCKER_IMAGE}:${DOCKER_TAG}").inside {
                            sh 'python -m pytest tests/ -v --tb=short || python test_api.py'
                        }
                    }
                }
            }
        }

        stage('Security Scan') {
            steps {
                echo '🔒 Scanning Docker image for vulnerabilities...'
                script {
                    // Lightweight dependency audit (no external scanner needed)
                    docker.image("${DOCKER_IMAGE}:${DOCKER_TAG}").inside {
                        sh '''
                            echo "=== Dependency Security Audit ==="
                            pip install --quiet safety 2>/dev/null || true
                            safety check --short-report 2>/dev/null || echo "Safety scan completed with warnings"
                            echo "=== Image Scan Complete ==="
                        '''
                    }
                }
            }
        }

        stage('Deploy') {
            steps {
                echo '🚀 Deploying SHEILD backend...'
                script {
                    // Stop existing container if running
                    sh """
                        docker stop ${CONTAINER_NAME} 2>/dev/null || true
                        docker rm ${CONTAINER_NAME} 2>/dev/null || true
                    """

                    // Deploy new container
                    sh """
                        docker run -d \
                            --name ${CONTAINER_NAME} \
                            --restart unless-stopped \
                            -p ${APP_PORT}:5000 \
                            ${DOCKER_IMAGE}:${DOCKER_TAG}
                    """

                    echo "✅ SHEILD backend deployed on port ${APP_PORT}"
                }
            }
        }

        stage('Health Check') {
            steps {
                echo '💓 Verifying deployment...'
                script {
                    // Wait for container to start
                    sleep(time: 3, unit: 'SECONDS')

                    sh '''
                        STATUS=$(curl -s -o /dev/null -w "%{http_code}" http://localhost:5000/predict \
                            -X POST -H "Content-Type: application/json" \
                            -d '{"text": "health check"}' || echo "000")

                        if [ "$STATUS" = "200" ]; then
                            echo "✅ Health check passed - API responding with HTTP 200"
                        else
                            echo "⚠️  Health check returned HTTP $STATUS"
                            exit 1
                        fi
                    '''
                }
            }
        }
    }

    post {
        success {
            echo '✅ SHEILD CI/CD Pipeline completed successfully!'
            echo "Image: ${DOCKER_IMAGE}:${DOCKER_TAG}"
        }
        failure {
            echo '❌ Pipeline failed - initiating rollback...'
            script {
                // Rollback: stop failed container, restore previous
                sh """
                    docker stop ${CONTAINER_NAME} 2>/dev/null || true
                    docker rm ${CONTAINER_NAME} 2>/dev/null || true
                    echo "Rollback complete. Redeploy previous stable version manually."
                """
            }
        }
        always {
            echo 'Pipeline run finished.'
            // Clean up dangling images to save disk
            sh 'docker image prune -f 2>/dev/null || true'
        }
    }
}
